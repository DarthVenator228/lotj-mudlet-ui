[
  {
    "name": "clickable_changes",
    "patterns": [
      {
        "pattern": "^\\( {0,3}(\\d+)\\).+on.+by.+$",
        "type": "regex"
      },
      {
        "pattern": "^.*[Cc]hanges\\s*( {0,3}\\d+)\\'*.*$",
        "type": "regex"
      }
    ]
  },
  {
    "name": "clickable_mail",
    "patterns": [
      {
        "pattern": "^ID\\s*\\|\\s*(?:SENDER|FROM)\\s*\\|\\s*(?:RECIPIENT|TO)\\s*\\|\\s*SUBJECT\\s*$",
        "type": "regex"
      },
      {
        "pattern": "^-+$",
        "type": "regex"
      }
    ],
    "multiline": "yes",
    "multilineDelta": "1"
  },
  {
    "name": "study",
    "patterns": [
        {
            "pattern": "^After some time studying you feel you know more\\.$",
            "type": "regex"
        },
        {
            "pattern": "^You study it for some time, but fail to learn anything about it\\.$",
            "type": "regex"
        },
        {
            "pattern": "^Copyover recovery complete\\.$",
            "type": "regex"
        }
    ]
  },
  {
    "name": "gag_blanklines",
    "patterns": [
      {
        "pattern": "^\\s*$",
        "type": "regex"
      }
    ]
  }
]
